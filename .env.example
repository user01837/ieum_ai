# ChromaDB 저장 경로 (로컬 디스크에 벡터 데이터 저장)
CHROMA_PERSIST_DIR=./chroma_data

# 임베딩 모델 (한국어 특화)
EMBEDDING_MODEL=jhgan/ko-sbert-nli

# Ollama 서버 (분류기 + 생성 LLM 둘 다 여기로 호출)
OLLAMA_HOST=http://localhost:11434
CLASSIFIER_MODEL_NAME=handover-classifier
GENERATION_MODEL_NAME=llama3.1:8b

# 이 AI 서버 자체 포트 (backend의 .env AI_SERVER=http://localhost:8100 같은 값과 맞춰야 함)
AI_SERVER_PORT=8100
